options:
  parameters:
    author: Group 05 ECE310
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Tone in noise through the isac Energy Detector, results saved to files.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: energy_detector_demo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Energy detector demo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: fft_size
  id: variable
  parameters:
    comment: ''
    value: '256'
  states:
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: avg_len
  id: variable
  parameters:
    comment: ''
    value: '8'
  states:
    coordinate: [300, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '1000000'
  states:
    coordinate: [400, 12]
    rotation: 0
    state: enabled
- name: analog_noise_source_x_0
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: Unit-power complex noise (amp 1.0 gives power 1.0)
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '42'
    type: complex
  states:
    coordinate: [40, 140]
    rotation: 0
    state: enabled
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: Tone at +125 kHz = bin 32 of 256 at 1 MS/s
    freq: samp_rate * 32 / fft_size
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    coordinate: [40, 300]
    rotation: 0
    state: enabled
- name: blocks_add_xx_0
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    coordinate: [300, 220]
    rotation: 0
    state: enabled
- name: blocks_head_0
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: 'Stop after 40 outputs'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: 40 * fft_size * avg_len
    type: complex
    vlen: '1'
  states:
    coordinate: [460, 220]
    rotation: 0
    state: enabled
- name: isac_energy_detector_cf_0
  id: isac_energy_detector_cf
  parameters:
    affinity: ''
    alias: ''
    avg_len: avg_len
    comment: ''
    fft_size: fft_size
    maxoutbuf: '0'
    minoutbuf: '0'
    relative: 'True'
    threshold_db: '6.0'
  states:
    coordinate: [640, 220]
    rotation: 0
    state: enabled
- name: blocks_file_sink_psd
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: /tmp/isac_demo_psd.f32
    type: float
    unbuffered: 'False'
    vlen: fft_size
  states:
    coordinate: [900, 180]
    rotation: 0
    state: enabled
- name: blocks_file_sink_occ
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: /tmp/isac_demo_occupied.u8
    type: byte
    unbuffered: 'False'
    vlen: fft_size
  states:
    coordinate: [900, 260]
    rotation: 0
    state: enabled
- name: blocks_file_sink_dec
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: /tmp/isac_demo_decision.u8
    type: byte
    unbuffered: 'False'
    vlen: '1'
  states:
    coordinate: [900, 340]
    rotation: 0
    state: enabled

connections:
- [analog_noise_source_x_0, '0', blocks_add_xx_0, '0']
- [analog_sig_source_x_0, '0', blocks_add_xx_0, '1']
- [blocks_add_xx_0, '0', blocks_head_0, '0']
- [blocks_head_0, '0', isac_energy_detector_cf_0, '0']
- [isac_energy_detector_cf_0, '0', blocks_file_sink_psd, '0']
- [isac_energy_detector_cf_0, '1', blocks_file_sink_occ, '0']
- [isac_energy_detector_cf_0, '2', blocks_file_sink_dec, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
