options:
  parameters:
    author: Group 05 ECE310
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: OFDM ISAC chain. One moving target is sensed (range, speed) with the same OFDM signal that carries data.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: isac_ofdm_demo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ISAC OFDM demo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: frame_len
  id: variable
  parameters:
    comment: 128 OFDM symbols of 256 + 64 samples
    value: '128 * (256 + 64)'
  states:
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: isac_ofdm_isac_tx_c_0
  id: isac_ofdm_isac_tx_c
  parameters:
    affinity: ''
    alias: ''
    carrier_freq: 5.8e9
    comment: Sends random QPSK data on 192 subcarriers
    cp_len: '64'
    fft_size: '256'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_active: '192'
    n_symbols: '128'
    pilot_spacing: '4'
    sample_rate: 10e6
    seed: '1'
  states:
    coordinate: [40, 180]
    rotation: 0
    state: enabled
- name: blocks_head_0
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: Stop after 5 frames
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: 5 * frame_len
    type: complex
    vlen: '1'
  states:
    coordinate: [280, 180]
    rotation: 0
    state: enabled
- name: isac_moving_target_channel_cc_0
  id: isac_moving_target_channel_cc
  parameters:
    affinity: ''
    alias: ''
    carrier_freq: 5.8e9
    comment: 'One target: 300 m away, 20 m/s towards us, echo -20 dB'
    max_range: '1000.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_taps: '33'
    noise_power: '0.001'
    one_way: 'False'
    sample_rate: 10e6
    seed: '7'
    targets: '[(300.0, 20.0, -20.0)]'
  states:
    coordinate: [500, 120]
    rotation: 0
    state: enabled
- name: isac_ofdm_sensing_rx_ccf_0
  id: isac_ofdm_sensing_rx_ccf
  parameters:
    affinity: ''
    alias: ''
    carrier_freq: 5.8e9
    comment: Divides the echo by the sent signal, makes the range-Doppler map, runs 2-D CFAR
    cp_len: '64'
    doppler_pad: '2'
    fft_size: '256'
    guard_cells: (4, 4)
    latency_samples: '16'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_active: '192'
    n_symbols: '128'
    pfa: '1e-8'
    pilot_spacing: '4'
    range_pad: '2'
    sample_rate: 10e6
    train_cells: (8, 8)
    use_window: 'True'
  states:
    coordinate: [780, 160]
    rotation: 0
    state: enabled
- name: blocks_file_sink_map
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: Range-Doppler map in dB, one vector per frame
    file: /tmp/isac_demo_map.f32
    type: float
    unbuffered: 'False'
    vlen: 128 * 2 * (64 - 16) * 2
  states:
    coordinate: [1060, 140]
    rotation: 0
    state: enabled
- name: blocks_message_debug_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: Prints the list of targets for every frame
    en_uvec: 'True'
    log_level: info
  states:
    coordinate: [1060, 260]
    rotation: 0
    state: enabled

connections:
- [blocks_head_0, '0', isac_moving_target_channel_cc_0, '0']
- [blocks_head_0, '0', isac_ofdm_sensing_rx_ccf_0, '1']
- [isac_moving_target_channel_cc_0, '0', isac_ofdm_sensing_rx_ccf_0, '0']
- [isac_ofdm_isac_tx_c_0, '0', blocks_head_0, '0']
- [isac_ofdm_sensing_rx_ccf_0, '0', blocks_file_sink_map, '0']
- [isac_ofdm_sensing_rx_ccf_0, targets, blocks_message_debug_0, print]

metadata:
  file_format: 1
  grc_version: 3.10.9.2
